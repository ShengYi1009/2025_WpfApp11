<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="500*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500*" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="500*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="Beige" Orientation="Horizontal">
            <Label Content="學生" Margin="50,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
            <ComboBox x:Name="StudentComboBox" Width="300" Height="30" Margin="20,0,0,0" VerticalAlignment="Center" FontSize="16" />
        </StackPanel>
        <TabControl Grid.Row="1" Grid.Column="0" Margin="5">
            <TabItem Header="以教師分類課程" >
                <TreeView x:Name="TeacherTreeView" Background="#FFE9F7DE" Margin="5">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:Teacher}" ItemsSource="{Binding TeachingCourses}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TeacherName}" FontSize="16" FontWeight="Bold" Margin="2"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type local:Course}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CourseName}" FontSize="16" FontWeight="Bold" Foreground="Blue" Margin="5, 3, 3, 3"/>
                                <TextBlock Text="{Binding Type}" FontSize="16" Margin="10,3,0,3"/>
                                <TextBlock Text=" (" FontSize="16" Margin="0"/>
                                <TextBlock Text="{Binding Point}" FontSize="16" Margin="0,3,0,3"/>
                                <TextBlock Text="學分)" FontSize="16" Margin="0,3,0,3"/>
                                <TextBlock Text=" - " FontSize="16" Margin="5,3,0,3"/>
                                <TextBlock Text="{Binding OpeningClass}" FontSize="16" Margin="10,3,0,3"/>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </TabItem>
            <TabItem Header="所有課程">
                <ListBox x:Name="CourseListBox" Background="#FFE0F0F5" Margin="5"/>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical">
            <Button x:Name="AddButton" Content="選課" Width="80" Height="40" FontSize="16" FontWeight="Bold" Margin="0, 50, 0, 0"/>
            <Button x:Name="DeleteButton" Content="退選" Width="80" Height="40" FontSize="16" FontWeight="Bold" Margin="0, 50, 0, 0"/>
            <Button x:Name="SaveButton" Content="存檔" Width="80" Height="40" FontSize="16" FontWeight="Bold" Margin="0, 50, 0, 0"/>
        </StackPanel>
        <ListView x:Name="RecordListView" Grid.Row="1" Grid.Column="2" Background="#FFFBF4E5" Margin="5,5,10,5"/>
        <StatusBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"/>
    </Grid>
</Window>
